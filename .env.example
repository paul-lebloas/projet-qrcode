# Copier ce fichier vers .env puis changer les mots de passe :
#   cp .env.example .env
#
# Aucune de ces valeurs n'est exposée hors du réseau Docker.

POSTGRES_DB=produits
POSTGRES_USER=produits
POSTGRES_PASSWORD=change-me-postgres

REDIS_PASSWORD=change-me-redis
REDIS_MAXMEMORY=128mb

# Durée de vie dans le cache Redis d'un produit trouvé / d'un produit inconnu (secondes)
CACHE_TTL_SECONDS=600
CACHE_NEGATIVE_TTL_SECONDS=60
